# ==========================================
# DESIGN FEEDBACK HUB - ENVIRONMENT VARIABLES
# ==========================================

# Google Gemini API Key (Server-Side ONLY)
# Obtain from Google AI Studio (https://aistudio.google.com/)
#
# SECURITY NOTE:
# This key is strictly used on the server within `/api/ai/analyze-feedback`.
# It is NEVER prefixed with NEXT_PUBLIC_ and NEVER exposed to browser Local Storage.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
