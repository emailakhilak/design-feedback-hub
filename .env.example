# ==========================================
# DESIGN FEEDBACK HUB - ENVIRONMENT VARIABLES
# ==========================================

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
